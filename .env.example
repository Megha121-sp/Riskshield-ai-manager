# Server Configuration
PORT=8000
HOST=0.0.0.0
DEBUG=True
ENVIRONMENT=development

# Database Configuration
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=riskshield_db

# Security & JWT
SECRET_KEY=riskshield-ai-production-super-secret-jwt-key-2026-secure
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# LLM Configuration (OpenAI / OpenRouter / Local LLM compatible)
# Leave blank or omit to use the built-in Deterministic AI Investigation Agent Fallback
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0.2

# Risk Engine Thresholds & Weights
RISK_WEIGHT_ML_FRAUD_PROB=0.35
RISK_WEIGHT_ANOMALY=0.20
RISK_WEIGHT_VELOCITY=0.15
RISK_WEIGHT_BEHAVIOURAL=0.15
RISK_WEIGHT_DEVICE=0.10
RISK_WEIGHT_LOCATION=0.05

RISK_THRESHOLD_LOW=30
RISK_THRESHOLD_HIGH=70

# CORS Allowed Origins
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173","http://127.0.0.1:3000"]
